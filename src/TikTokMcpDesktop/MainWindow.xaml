<Window x:Class="TikTokMcpDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TikTok MCP Desktop"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="960"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
          <TextBlock Text="TikTok MCP" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="Desktop" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel>
          <Button Style="{StaticResource NavButton}" Content="设置" Click="Nav_Click" Tag="settings"/>
          <Button Style="{StaticResource NavButton}" Content="连接" Click="Nav_Click" Tag="connect"/>
          <Button Style="{StaticResource NavButton}" Content="同步" Click="Nav_Click" Tag="sync"/>
          <Button Style="{StaticResource NavButton}" Content="对话" Click="Nav_Click" Tag="chat"/>
          <Button Style="{StaticResource NavButton}" Content="表格" Click="Nav_Click" Tag="table"/>
          <Button Style="{StaticResource NavButton}" Content="看板" Click="Nav_Click" Tag="dashboard"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="16" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   Text="{Binding LocalApiStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                   TextWrapping="Wrap"/>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1" Margin="20">
      <!-- Settings -->
      <ScrollViewer x:Name="PageSettings" Visibility="Visible" VerticalScrollBarVisibility="Auto">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel MaxWidth="640">
            <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <Label Content="OpenAI 兼容 Base URL"/>
            <TextBox x:Name="TxtBaseUrl"/>
            <Label Content="API Key"/>
            <PasswordBox x:Name="TxtApiKey"/>
            <Label Content="Model"/>
            <TextBox x:Name="TxtModel"/>
            <Label Content="TikTok MCP client_id"/>
            <TextBox x:Name="TxtClientId"/>
            <Label Content="MCP 变体"/>
            <ComboBox x:Name="CmbVariant" Margin="0,0,0,10">
              <ComboBoxItem Content="layer" Tag="Layer" IsSelected="True"/>
              <ComboBoxItem Content="flat" Tag="Flat"/>
            </ComboBox>
            <Label Content="换票格式"/>
            <ComboBox x:Name="CmbTokenFormat" Margin="0,0,0,10">
              <ComboBoxItem Content="JSON body（推荐）" Tag="Json" IsSelected="True"/>
              <ComboBoxItem Content="form-urlencoded（调试回退）" Tag="Form"/>
            </ComboBox>
            <Label Content="同步间隔（分钟）"/>
            <TextBox x:Name="TxtSyncInterval"/>
            <CheckBox x:Name="ChkAutoSync" Content="启用定时自动同步" Margin="0,0,0,16"/>
            <Button Content="保存设置" Click="SaveSettings_Click" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtSettingsStatus" Margin="0,12,0,0" Foreground="{StaticResource AccentBrush}"/>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- Connect -->
      <ScrollViewer x:Name="PageConnect" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="TikTok Open MCP 连接" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="浏览器授权 → 本机回调 → 换票。切换 flat/layer 需重新授权。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
            <TextBlock x:Name="TxtAuthStatus" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="TxtTokenExpiry" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="授权登录" Click="Authorize_Click" Margin="0,0,8,0"/>
              <Button Content="探测 tools/list" Click="ListTools_Click" Background="#334155"/>
            </StackPanel>
            <TextBox x:Name="TxtTools" Margin="0,16,0,0" Height="320" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True" FontFamily="Consolas" FontSize="12"/>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- Sync -->
      <Grid x:Name="PageSync" Visibility="Collapsed">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="数据同步" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock x:Name="TxtSyncSummary" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
              <Button Content="立即同步" Click="SyncNow_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            </StackPanel>
            <ListBox x:Name="LstSyncLogs" FontFamily="Consolas" FontSize="12"/>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Chat -->
      <Grid x:Name="PageChat" Visibility="Collapsed">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="对话查数" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button DockPanel.Dock="Right" Content="发送" Click="SendChat_Click" Width="88" Margin="8,0,0,0"/>
              <TextBox x:Name="TxtChatInput" Height="40" VerticalContentAlignment="Center" KeyDown="TxtChatInput_KeyDown"/>
            </DockPanel>
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="LstChat">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="12" CornerRadius="8" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                      <StackPanel>
                        <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Table / Dashboard via WebView2 -->
      <Grid x:Name="PageWeb" Visibility="Collapsed">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
          <DockPanel>
            <TextBlock x:Name="TxtWebHint" DockPanel.Dock="Top" Margin="16,12" Foreground="{StaticResource MutedBrush}"
                       Text="需要 WebView2 Runtime。若空白请安装 Evergreen Runtime。"/>
            <wv2:WebView2 x:Name="WebView"/>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
